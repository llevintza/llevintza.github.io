{
  "name": "llevintza-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:live-sites": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-live-sites.mjs",
    "test:featured": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/projects/*.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:public-content": "node scripts/check-public-content.mjs",
    "test:public-content": "node --test scripts/__tests__/check-public-content.test.mjs",
    "lhci": "pnpm dlx @lhci/cli@0.16.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@shikijs/rehype": "^4.6.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "serve": "^14",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
